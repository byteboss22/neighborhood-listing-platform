{
  "name": "neighborhood-listing-platform-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:live": "node --env-file=.env.local scripts/verify-supabase-live.mjs",
    "test:live:categories": "node --env-file=.env.local scripts/verify-supabase-categories.mjs",
    "auth:reset-providers": "node --env-file=.env.local scripts/reset-test-passwords.mjs",
    "validate:data": "tsx scripts/validate-listings.ts",
    "schema:export": "tsx scripts/export-listing-schema.ts",
    "schema:check": "tsx scripts/export-listing-schema.ts --check",
    "test:lab3": "tsx --test tests/listing-contract.test.ts",
    "test:midterm": "node --conditions=react-server --import tsx --test tests/api.test.ts tests/client-authorization.test.ts tests/password-input.test.ts tests/security.test.ts",
    "test:ui:production": "playwright test --config=playwright.production.config.ts",
    "test:lab6": "tsx --test tests/lab6-*.test.ts",
    "demo:lab6": "tsx scripts/demo-sponsor-selection.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
